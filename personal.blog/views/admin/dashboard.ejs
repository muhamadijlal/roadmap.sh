<%- include("../partials/header", { title: "Dashboard" }) %>

<div class="toolbar">
  <h1>Dashboard</h1>
  <a class="btn" href="/admin/new">+ Artikel baru</a>
</div>

<% if (articles.length === 0) { %>
  <p>Belum ada artikel.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Judul</th><th>Tanggal</th><th>Aksi</th></tr>
    </thead>
    <tbody>
      <% articles.forEach(a => { %>
        <tr>
          <td><a href="/articles/<%= a.id %>"><%= a.title %></a></td>
          <td><%= a.publishedAt %></td>
          <td class="actions">
            <a href="/admin/edit/<%= a.id %>">Edit</a>
            <a href="/admin/delete/<%= a.id %>">Hapus</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include("../partials/footer") %>
